# Source downloads (HMDB ~6.5 GB, BMDB ~450 MB): see RUNNING.md for where they go.
*.xml

# Generated by the pipeline (see RUNNING.md)
data/parsed/
data/*.db
*.db-journal

# HMDB rebuildable extract; rebuild with pipeline/hmdb/extract_hmdb.py
data/hmdb/hmdb_normal_concentrations_raw.csv

# YMDB scrape working files (~70 MB of saved pages); rebuild with pipeline/ymdb/extract_ymdb_concentrations.py
data/ymdb/xml/
data/ymdb/status.jsonl
data/ymdb/ymdb_concentrations_clean.csv
# YMDB download files: get them from https://www.ymdb.ca/downloads
data/ymdb/downloads/

# ECMDB working files and rebuildable extracts
data/ecmdb/xml/
data/ecmdb/status.jsonl
data/ecmdb/ecmdb_concentrations_clean.csv
data/ecmdb/ecmdb_metabolites.csv
data/ecmdb/ecmdb_sdf_full.csv
# ECMDB download files: get them from https://ecmdb.ca/downloads
data/ecmdb/downloads/

.DS_Store
__pycache__/
notes/
_to_delete/

# Metabolomics Workbench working files; rebuild with pipeline/mwb/survey_mwb.py fetch
data/mwb/mwtab/
data/mwb/status.jsonl
data/mwb/*.json

# BMDB rebuildable extracts; rebuild with pipeline/bmdb/extract_bmdb_concentrations.py
data/bmdb/bmdb_concentrations_all.csv
data/bmdb/bmdb_concentrations_clean.csv

